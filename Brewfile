# -----------------------------------------------------------------------------
# Homebrew Taps (サードパーティリポジトリ)
# -----------------------------------------------------------------------------
tap 'homebrew/bundle'            # Brewfile (Homebrew Bundle) 管理機能
tap 'homebrew/cask'              # macOS GUI アプリケーション用 Cask リポジトリ
tap 'homebrew/cask-fonts'        # 開発用フォント Cask リポジトリ
tap 'homebrew/core'              # Homebrew 公式 CLI フォーミュラリポジトリ
tap 'homebrew/services'          # バックグラウンドサービス管理 (brew services)
tap 'olets/tap'                  # zsh-abbr 用サードパーティ tap
tap 'wez/wezterm'                # WezTerm 用公式 tap

# -----------------------------------------------------------------------------
# CLI ツール / パッケージ
# -----------------------------------------------------------------------------
brew 'alp'                       # Access Log Parser (LTSV/JSON 等のアクセスログ集計ツール)
brew 'awscli'                    # AWS (Amazon Web Services) 公式 CLI ツール
brew 'bat'                       # 構文ハイライト・Git 変更表示対応の cat コマンド代替
brew 'chezmoi'                   # dotfiles 設定ファイルマネージャー
brew 'cmake'                     # クロスプラットフォームのビルドシステム生成ツール
brew 'desktop-file-utils'        # .desktop ファイルの検証・操作ユーティリティ
brew 'eza'                       # 構文ハイライト・ツリー表示対応の ls コマンド拡張
brew 'fd'                        # シンプルで高速な find コマンド代替
brew 'fzf'                       # コマンドライン曖昧検索 (Fuzzy Finder)
brew 'gcc'                       # GNU Compiler Collection (C/C++ コンパイラ)
brew 'gitui'                     # 高速で軽量な TUI 版 Git クライアント
brew 'glow'                      # ターミナル用 Markdown ビューア
brew 'imagemagick'               # 画像編集・変換コマンドラインツール
brew 'jq'                        # JSON データ処理・フィルタリングツール
brew 'jql'                       # Rust 製の JSON クエリ言語・プロセッサ
brew 'libyaml'                   # YAML パース・生成ライブラリ
brew 'mise'                      # 多言語（Node/Python/Go/Ruby等）開発環境バージョンマネージャー
brew 'neofetch'                  # システム情報表示 CLI ツール
brew 'neovim'                    # 拡張性の高い Vim 派生テキストエディタ
brew 'ripgrep'                   # 超高速テキスト検索ツール (grep 代替)
brew 'sheldon'                   # Rust 製の高速 zsh プラグインマネージャー
brew 'starship'                  # 高速・カスタマイズ可能なクロスシェルプロンプト
brew 'tmux'                      # ターミナルマルチプレクサ (画面分割・セッション管理)
brew 'tree-sitter'               # インクリメンタル構文解析ライブラリ
brew 'wget'                      # HTTP/HTTPS/FTP ファイルダウンロードツール
brew 'yazi'                      # 非同期 I/O・ターミナル画像プレビュー対応 TUI ファイルマネージャー
brew 'zoxide'                    # 履歴に基づきスマートにディレクトリ移動する cd コマンド拡張

# -----------------------------------------------------------------------------
# zsh プラグイン
# -----------------------------------------------------------------------------
brew 'zsh-autopair'              # 括弧や引用符を自動補完する zsh プラグイン
brew 'zsh-autosuggestions'       # 履歴に基づく自動入力補完候補表示プラグイン
brew 'zsh-completions'           # 追加のコマンド補完定義集
brew 'zsh-fast-syntax-highlighting' # 高速なコマンド構文ハイライトプラグイン
brew 'olets/tap/zsh-abbr'        # 自動展開対応の略称 (abbreviation) 管理プラグイン

# -----------------------------------------------------------------------------
# GUI アプリケーション / フォント (Cask)
# -----------------------------------------------------------------------------
cask 'alacritty'                 # GPU アクセラレーション対応の高速ターミナルエミュレータ
cask 'appcleaner'                # 関連ファイルを含めてアプリを完全に削除するアンインストーラー
cask 'font-fira-code'            # 合字 (ligatures) 対応プログラミングフォント Fira Code
cask 'font-hackgen-nerd'         # 白源 (HackGen) Nerd Fonts 組み込みプログラミングフォント
cask 'obsidian'                  # ローカル Markdown ベースのナレッジベース・メモアプリ
cask 'raycast'                   # 高機能・拡張可能な Mac 用ランチャーアプリ (Spotlight 代替)
cask 'wezterm'                   # GPU アクセラレーション・Lua 設定対応ターミナルエミュレータ
